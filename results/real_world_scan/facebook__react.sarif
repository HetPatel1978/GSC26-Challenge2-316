{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cicd-vuln-scanner",
          "version": "0.1.0",
          "informationUri": "https://github.com/placeholder/cicd-vuln-scanner",
          "rules": [
            {
              "id": "unpinned-action",
              "shortDescription": {
                "text": "Unpinned action"
              }
            },
            {
              "id": "cache-poisoning",
              "shortDescription": {
                "text": "Cache poisoning"
              }
            },
            {
              "id": "script-injection",
              "shortDescription": {
                "text": "Script injection"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "unpinned-action",
          "level": "warning",
          "message": {
            "text": "`actions/checkout@v4` is pinned to a mutable ref, not a commit SHA -- whoever controls that tag or branch can repoint it to different content at any time, and the next run of this workflow executes whatever it now resolves to."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
