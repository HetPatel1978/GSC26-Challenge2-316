        {
          "ruleId": "cache-poisoning",
          "level": "error",
          "message": {
            "text": "`actions/cache` writes to the Actions cache in a `pull_request`-triggered job; GitHub's cache restore rules let a same-branch-hierarchy base-branch run later restore an entry written by a forked PR run, letting a malicious PR poison what a privileged build later trusts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
